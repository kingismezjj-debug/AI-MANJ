# Copy to .env if you want real providers. docker compose up works with none of these set.
# 复制为 .env 后填写密钥。不填也能用本地模拟跑完整条流水线。

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=dall-e-3

ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDREAM_MODEL=doubao-seedream-4-5-251128
SEEDANCE_MODEL=doubao-seedance-2-0-260128

# Prefer a console API key. AK/SK is only for the legacy model_name APIs.
KLING_API_KEY=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_BASE_URL=https://api-singapore.klingai.com
KLING_VIDEO_MODEL=kling-v2-6

MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com
MINIMAX_MODEL=speech-2.6-hd
MINIMAX_VOICE_ID=male-qn-qingse

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

VIDEO_HTTP_API_KEY=

# Public URL Kling can fetch when lip-sync is not mocked. Leave empty for local mock runs.
S3_PUBLIC_ENDPOINT=

# Studio logins. Markup is applied to the pre-run hold and to the final settlement.
ADMIN_API_KEY=zc-dev-admin
DEV_USER_API_KEY=zc-dev-user
DEV_USER_CREDITS=100
CREDIT_MARKUP=1.2
